<div id="choices" class="w-4/5 mx-auto mb-12">
  <div class="grid grid-cols-2 gap-8">

    <!-- Left column: incoming -->
    <div class="flex flex-col gap-2">
      {{#has_incoming}}
      <div class="flex items-center justify-center gap-3 my-2 text-orange-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
        </svg>
      </div>
      <ul class="flex flex-col gap-2">
        {{#incoming}}
        <li class="flex items-center bg-white dark:bg-neutral-800 border border-neutral-100 dark:border-neutral-700 rounded hover:border-orange-200 dark:hover:border-orange-500">
          <a href="/stories/{{story_slug}}/steps/{{step_slug}}" class="flex w-full px-4 py-2">
            <div class="flex flex-col min-w-0">
              <div class="text-sm text-neutral-500 dark:text-neutral-400"><small class="text-orange-500">from</small> {{step_name}}</div>
              {{#prompt}}
              <span class="text-neutral-900 dark:text-neutral-100">&ldquo;{{prompt}}&rdquo;</span>
              {{/prompt}}
            </div>
          </a>
        </li>
        {{/incoming}}
      </ul>
      {{/has_incoming}}
    </div>

    <!-- Right column: outgoing -->
    <div class="flex flex-col gap-2">
      {{#has_outgoing}}
      <div class="flex items-center justify-center gap-3 my-2 text-orange-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
      </div>
      <ol id="outgoing-choices" class="flex flex-col gap-2">
        {{#outgoing}}
        <li data-choice-id="{{id}}" class="group bg-white dark:bg-neutral-800 border border-neutral-100 dark:border-neutral-700 rounded hover:border-orange-200 dark:hover:border-orange-500">
          <div class="choice-display flex items-center gap-2 px-4 pr-3 py-2">
            <a href="/stories/{{story_slug}}/steps/{{step_slug}}" class="flex-1 min-w-0">
              {{#prompt}}
              <span class="text-neutral-900 dark:text-neutral-100">&ldquo;{{prompt}}&rdquo;</span>
              <div class="text-neutral-400 text-sm"><small class="text-orange-500">to</small> {{step_name}}</div>
              {{/prompt}}
              {{^prompt}}
              <span class="text-neutral-400 text-sm">{{step_name}}</span>
              {{/prompt}}
            </a>
            <div class="drag-handle cursor-grab active:cursor-grabbing shrink-0 text-neutral-300 dark:text-neutral-600 hover:text-neutral-500 dark:hover:text-neutral-400 select-none px-1" title="Drag to reorder">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75ZM2 10a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Zm0 5.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="flex flex-col gap-1 shrink-0">
              <button type="button" class="cursor-pointer px-3 py-1.5 text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-600 rounded hover:bg-neutral-100 dark:hover:bg-neutral-700" title="Edit choice">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <script>
                  me().on("click", ev => {
                    const li = me(ev).closest("li")
                    any(".choice-display", li).classToggle("hidden")
                    any(".choice-edit", li).classToggle("hidden")
                  })
                </script>
              </button>
              <form method="POST" action="/stories/{{story_slug}}/steps/{{current_step_slug}}/choices/{{id}}/delete"
                    hx-post="/stories/{{story_slug}}/steps/{{current_step_slug}}/choices/{{id}}/delete"
                    hx-target="#choices" hx-swap="outerHTML">
                <button type="submit" class="cursor-pointer w-full px-3 py-1.5 text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-600 rounded hover:bg-red-50 dark:hover:bg-red-900/20 hover:border-red-300 dark:hover:border-red-700 hover:text-red-700 dark:hover:text-red-400" title="Remove choice">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                </button>
              </form>
            </div>
          </div>
          <form class="choice-edit hidden flex items-center gap-2 w-full px-4 py-2"
                method="POST" action="/stories/{{story_slug}}/steps/{{current_step_slug}}/choices/{{id}}"
                hx-post="/stories/{{story_slug}}/steps/{{current_step_slug}}/choices/{{id}}"
                hx-target="#choices" hx-swap="outerHTML">
            <input type="text" name="prompt" value="{{prompt}}"
              class="flex-1 p-2 text-sm border dark:border-neutral-700 dark:bg-neutral-800 rounded focus:outline-none focus:ring focus:ring-zinc-200 dark:focus:ring-zinc-700" />
            <button type="submit" class="btn-sm">save</button>
            <button type="button" class="btn-sm btn-light">cancel
              <script>
                me().on("click", ev => {
                  const li = me(ev).closest("li")
                  any(".choice-display", li).classToggle("hidden")
                  any(".choice-edit", li).classToggle("hidden")
                })
              </script>
            </button>
          </form>
        </li>
        {{/outgoing}}
      </ol>
      <script>
        (function() {
          var el = document.getElementById('outgoing-choices');
          if (!el || !el.children.length) return;
          function init() {
            Sortable.create(el, {
              handle: '.drag-handle',
              animation: 150,
              onEnd: function() {
                var ids = [];
                for (var i = 0; i < el.children.length; i++) {
                  ids.push(el.children[i].getAttribute('data-choice-id'));
                }
                var url = el.closest('[id="choices"]').querySelector('form[action*="/choices/"]').action;
                var base = url.replace(/\/choices\/.*$/, '/choices/reorder');
                var opts = {target: '#choices', swap: 'outerHTML'};
                opts.values = {order: ids.join(',')};
                htmx.ajax('POST', base, opts);
              }
            });
          }
          if (typeof Sortable !== 'undefined') {
            init();
          } else {
            var s = document.createElement('script');
            s.src = '/static/Sortable.min.js';
            s.onload = init;
            document.head.appendChild(s);
          }
        })();
      </script>
      {{/has_outgoing}}

      <div class="mt-2">
        <div class="flex flex-col items-end">
        {{^has_outgoing}}
          <button id="choice-opener" type="button" class="btn btn-sm">
            what's next?
            <script>me().on("click", ev => { me("#choice-opener").classAdd("hidden"); me("#choice-adder").classRemove("hidden") })</script>
          </button>
        </div>
        {{/has_outgoing}}
        {{#has_outgoing}}
        <button id="choice-opener" type="button" class="btn btn-sm">
          what else could happen?
          <script>me().on("click", ev => { me("#choice-opener").classAdd("hidden"); me("#choice-adder").classRemove("hidden") })</script>
        </button>
        {{/has_outgoing}}
        </div>

        <form id="choice-adder" class="hidden px-6 py-3 mt-3 bg-white dark:bg-neutral-800 border dark:border-neutral-700 rounded"
              method="POST" action="/stories/{{story_slug}}/steps/{{step_slug}}/choices"
              hx-post="/stories/{{story_slug}}/steps/{{step_slug}}/choices"
              hx-target="#choices" hx-swap="outerHTML" hx-boost="false">
          <div class="grid items-center grid-cols-3">
            <label class="text-sm text-neutral-400">Chapter:</label>
            <select name="dest_step_id" class="col-span-2 p-2 text-sm border dark:border-neutral-700 dark:bg-neutral-800 rounded focus:outline-none focus:ring focus:ring-zinc-200 dark:focus:ring-zinc-700">
              <option value="new">-- new chapter --</option>
              {{#available_steps}}
              <option value="{{id}}">{{display_name}}</option>
              {{/available_steps}}
            </select>
          </div>
          <div class="grid items-center grid-cols-3 mt-2">
            <label class="text-sm text-neutral-400">Prompt:</label>
            <input type="text" name="prompt" class="col-span-2 p-2 text-sm border dark:border-neutral-700 dark:bg-neutral-800 rounded focus:outline-none focus:ring focus:ring-zinc-200 dark:focus:ring-zinc-700"
              placeholder="To do a backflip..." />
          </div>
          <div class="grid items-center grid-cols-3 mt-2">
            <div></div>
            <div class="col-span-2 flex gap-2 justify-end">
              <button type="button" class="btn-sm btn-light">nevermind
                <script>me().on("click", ev => { me("#choice-adder").classAdd("hidden"); me("#choice-opener").classRemove("hidden") })</script>
              </button>
              <button type="submit" class="btn-sm">add it</button>
            </div>
          </div>
        </form>
      </div>
    </div>

  </div>
</div>
