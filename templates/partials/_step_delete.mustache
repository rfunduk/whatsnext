<script>me('#modal').showModal()</script>
<div class="p-6">
  {{#is_default}}
    <h3 class="text-lg font-semibold mb-3">Cannot delete &ldquo;{{step_name}}&rdquo;</h3>
    <p class="text-neutral-500 dark:text-neutral-400 mb-4">
      This is the default chapter and cannot be deleted.
      Assign a different default chapter first.
    </p>
    <div class="flex justify-end">
      <button type="button" class="btn-secondary" onclick="me('#modal').close()">OK</button>
    </div>
  {{/is_default}}
  {{^is_default}}
    <h3 class="text-lg font-semibold mb-3">Delete &ldquo;{{step_name}}&rdquo;?</h3>

    {{#has_incoming}}
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-1">Incoming choices that will be removed:</p>
      <ul class="mb-3 ml-4 list-disc text-sm">
        {{#incoming}}
          <li>&ldquo;{{prompt}}&rdquo; <span class="text-neutral-400">from {{source_name}}</span></li>
        {{/incoming}}
      </ul>
    {{/has_incoming}}

    {{#has_outgoing}}
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-1">Outgoing choices that will be removed:</p>
      <ul class="mb-3 ml-4 list-disc text-sm">
        {{#outgoing}}
        <li>&ldquo;{{prompt}}&rdquo; <span class="text-neutral-400">to {{dest_name}}</span></li>
        {{/outgoing}}
      </ul>
    {{/has_outgoing}}

    {{^has_incoming}}{{^has_outgoing}}
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-3">No choices will be affected.</p>
    {{/has_outgoing}}{{/has_incoming}}

    <form method="POST" action="/stories/{{story_slug}}/steps/{{step_slug}}/delete">
      <div class="flex justify-end gap-3">
        <button type="button" class="btn-secondary" onclick="me('#modal').close()">Cancel</button>
        <button type="submit" class="btn-secondary hover:text-red-600 hover:border-red-600 dark:hover:text-red-400 dark:hover:border-red-400">Delete</button>
      </div>
    </form>
  {{/is_default}}
</div>
