<script>me('#modal').showModal()</script>
<div class="p-6">
  <h3 class="text-lg font-semibold mb-4">Settings for &ldquo;{{story_name}}&rdquo;</h3>

  <form method="POST" action="/stories/{{story_slug}}/settings"
        hx-post="/stories/{{story_slug}}/settings" hx-target="#modal-content" hx-swap="innerHTML" hx-boost="false">
    <div class="flex flex-col gap-4">
      <label class="flex items-center justify-between cursor-pointer">
        <span class="text-sm font-medium">Published</span>
        <input type="hidden" name="published" value="0" />
        <div class="relative">
          {{#published}}
            <input type="checkbox" name="published" value="1" checked
              class="sr-only peer" />
          {{/published}}
          {{^published}}
            <input type="checkbox" name="published" value="1"
              class="sr-only peer" />
          {{/published}}

          <div class="w-11 h-6 bg-neutral-200 dark:bg-neutral-600 border border-neutral-300 dark:border-neutral-500 rounded-full peer-checked:bg-orange-600 peer-checked:border-orange-600 transition-colors"></div>
          <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full transition-transform peer-checked:translate-x-5"></div>
        </div>
      </label>

      <div>
        <label class="text-sm font-medium block mb-1">URL Slug</label>
        <div class="flex font-mono text-sm">
          <span class="px-3 py-2 bg-neutral-100 dark:bg-neutral-700 text-neutral-500 dark:text-neutral-400 border border-r-0 dark:border-neutral-600 rounded-l">/stories/</span>
          <input type="text" name="slug" value="{{slug}}"
            pattern="[a-z0-9\-]+"
            class="flex-1 px-3 py-2 border dark:border-neutral-600 dark:bg-neutral-800 rounded-r focus:outline-none focus:ring focus:ring-zinc-200 dark:focus:ring-zinc-700" />
        </div>
        <p class="text-xs text-neutral-400 mt-1">lowercase letters, numbers, and dashes</p>
      </div>
    </div>

    {{#error}}
      <p class="text-sm text-red-600 dark:text-red-400 mt-4">{{error}}</p>
    {{/error}}

    <div class="flex justify-end gap-3 mt-5">
      <button type="button" class="btn-secondary" onclick="me('#modal').close()">Cancel</button>
      <button type="submit" class="btn-sm">Save</button>
    </div>
  </form>
</div>
