<ul class="w-4/5 mx-auto">
  {{#stories}}
    <li>
      <a href="/stories/{{slug}}"
        class="hover:bg-neutral-100 dark:hover:bg-neutral-800 block px-8 py-6 my-2 text-4xl border dark:border-neutral-700 rounded cursor-pointer">
        {{title}}{{^title}}Untitled Story{{/title}}
      </a>
    </li>
  {{/stories}}

  {{#has_stories}}
    <li>
      <form method="POST" action="/stories">
        <button type="submit"
          class="hover:bg-neutral-100 dark:hover:bg-neutral-800 flex items-center gap-2 w-full px-8 py-4 my-2 text-xl border dark:border-neutral-700 rounded cursor-pointer text-left">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-orange-500 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
          <span>Start a New Story!</span>
        </button>
      </form>
    </li>
  {{/has_stories}}

  {{^has_stories}}
    <li>
      <form method="POST" action="/stories">
        <button type="submit"
          class="hover:border-orange-300 hover:bg-orange-200 dark:hover:bg-orange-900 w-full p-20 text-3xl text-center text-neutral-800 dark:text-neutral-200 bg-orange-100 dark:bg-orange-950 border border-orange-200 dark:border-orange-800 rounded cursor-pointer">
          Write your first story!
        </button>
      </form>
    </li>
  {{/has_stories}}
</ul>
