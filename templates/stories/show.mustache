<form method="POST" action="/stories/{{story_slug}}" class="relative flex flex-col w-3/5 gap-3 mx-auto mt-2 mb-6">
  <input type="text" name="title"
    class="rounded px-4 py-3 text-3xl border dark:border-neutral-700 dark:bg-neutral-800 w-full focus:outline-none focus:ring focus:ring-zinc-200 dark:focus:ring-zinc-700"
    value="{{story_title}}" placeholder="Story Title" />

  <textarea name="description"
    class="px-4 py-3 w-full border dark:border-neutral-700 dark:bg-neutral-800 rounded text-xl mt-1 focus:outline-none focus:ring focus:ring-zinc-200 dark:focus:ring-zinc-700 resize-none overflow-hidden"
    rows="2" placeholder="Optionally add a couple of lines describing your story.">{{story_description}}</textarea>

  <div class="flex items-center justify-between">
    <div class="flex gap-1">
      <div class="relative">
        <button type="button" class="btn-secondary" style="display:inline-flex;align-items:center;gap:0.25rem">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          <span>export</span>
          <script>
            me().on("click", ev => {
              ev.stopPropagation()
              const menu = me(".export-menu", me(ev).closest(".relative"))
              const open = menu.classList.contains("hidden")
              menu.classToggle("hidden")
              if (open) {
                const close = () => { menu.classAdd("hidden"); document.removeEventListener("click", close, true) }
                setTimeout(() => document.addEventListener("click", close, true), 0)
              }
            })
          </script>
        </button>
        <div class="export-menu hidden absolute left-0 top-full mt-1 z-10 bg-white dark:bg-neutral-800 border dark:border-neutral-700 rounded shadow-lg min-w-36">
          <a href="/stories/{{story_slug}}/pdf/fullsize" target="_blank"
            class="block px-4 py-2 text-sm hover:bg-neutral-100 dark:hover:bg-neutral-700 rounded-t">Full size (A4)</a>
          <a href="/stories/{{story_slug}}/pdf/booklet" target="_blank"
            class="block px-4 py-2 text-sm hover:bg-neutral-100 dark:hover:bg-neutral-700 rounded-b">Booklet (A5)</a>
        </div>
      </div>
      <button type="button"
        hx-get="/stories/{{story_slug}}/settings" hx-target="#modal-content" hx-swap="innerHTML" hx-boost="false"
        class="btn-secondary" style="display:inline-flex;align-items:center;gap:0.25rem">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        <span>settings</span>
      </button>
      <button type="button"
        hx-get="/stories/{{story_slug}}/delete" hx-target="#modal-content" hx-swap="innerHTML" hx-boost="false"
        class="btn-secondary hover:bg-white dark:hover:bg-neutral-800 hover:text-red-600 hover:border-red-600">
        <span>&#10005;</span>&nbsp;
        <span>delete</span>
      </button>
    </div>
    <button type="submit" class="btn-sm">Save</button>
  </div>
</form>

{{> _chapters}}
